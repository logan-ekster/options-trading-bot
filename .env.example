# Copy this file to a new file named .env and paste your Alpaca keys in.
# NEVER commit .env. It is listed in .gitignore.

# Paper (fake money) keys - from https://app.alpaca.markets -> Paper -> API Keys
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=

# Live (real money) keys - leave blank until you've paper traded for weeks
ALPACA_LIVE_KEY=
ALPACA_LIVE_SECRET=
